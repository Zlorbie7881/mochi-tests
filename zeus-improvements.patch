+            if (clock.on()) join(line, java.time.LocalTime.now().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm")));
+            if (frames.on()) join(line, Brain.ctx().fps + " fps");
+            if (latency.on()) {
+                int ms = ping(mc);
+                if (ms >= 0) join(line, ms + " ms");
